 function dunklereVariante(hex: string): string {
   const m = /^#?([0-9a-fA-F]{6})$/.exec(hex.trim())
   if (!m) return hex
   const n = parseInt(m[1], 16)
   const r = Math.max(0, Math.round(((n >> 16) & 255) * 0.72))
   const g = Math.max(0, Math.round(((n >> 8) & 255) * 0.72))
